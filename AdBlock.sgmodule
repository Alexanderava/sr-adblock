http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/system\/service\/ui\/config\? 'def keep: ["sidebar_config_cart","sidebar_config_creator_center_profile","sidebar_config_draft","sidebar_config_download_profilepage","sidebar_config_order","sidebar_config_scan","sidebar_config_setting","sidebar_config_wallet"]; def prune: reduce .[] as $x ({out: [], sep: false}; if ($x | IN(keep[])) then ((.out += (if .sep then ["sidebar_config_divider"] else [] end) + [$x]) | .sep = false) elif $x == "sidebar_config_divider" then .sep = ((.out|length) > 0) else . end) | .out; if type=="object" and (.data|type)=="object" and (.data.sideConfigPersonalPage|type)=="object" then .data.sideConfigPersonalPage |= ((if (.componentConfig|type)=="object" then .componentConfig |= with_entries(select((.key | IN(keep[])) or (.key == "sidebar_config_divider"))) else . end) | (if (.hierarchy|type)=="object" and (.hierarchy.structure|type)=="object" then ((if (.hierarchy.structure.body|type)=="array" then .hierarchy.structure.body |= prune else . end) | (if (.hierarchy.structure.footer|type)=="array" then .hierarchy.structure.footer |= prune else . end)) else . end)) else . end'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/config\? 'if type=="object" and (.data|type)=="object" then delpaths([["data","loading_img"],["data","splash"],["data","store"],["data","home_banner"],["data","home_top_banner"],["data","my_banner"],["data","setting_banner"]]) else . end'
http-response-jq ^https?:\/\/edith\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/splash_config$ 'if type=="object" and (.data|type)=="object" then (setpath(["data","ads_groups"]; []) | setpath(["data","bidding_ads"]; [])) else . end'
http-response-jq ^https?:\/\/live-go\.xiaohongshu\.com\/api\/sns\/red\/live\/app\/v\d+\/ecology\/inform_card\/active_card\? 'if type=="object" and (.data|type)=="object" then setpath(["data","inform_cards"]; []) else . end'
http-response-jq ^https?:\/\/live-mall\.xiaohongshu\.com\/api\/sns\/red\/livemall\/app\/marketing\/get_config\? 'if type=="object" and (.data|type)=="object" then delpaths([["data","coupon_config"],["data","flash_buy"]]) else . end'
http-response-jq ^https?:\/\/live-room\.xiaohongshu\.com\/api\/sns\/red\/live\/rank\/entrance\/list\? 'if type=="object" and (.data|type)=="object" then setpath(["data","entrances"]; []) else . end'
http-response-jq ^https?:\/\/live-room\.xiaohongshu\.com\/api\/sns\/v\d+\/live\/feed\/waterfall$ 'if type=="object" and (.data|type)=="object" and (.data.feeds|type)=="array" then .data.feeds |= map(select((.|type)!="object" or (((.ads_live? // false) != true) and ((.ads_info? // "{}") == "{}")))) else . end'
http-response-jq ^https?:\/\/rec\.xiaohongshu\.com\/api\/sns\/v\d+\/user\/followings\/dualfeed\? 'if type=="object" and (.data|type)=="object" and (.data.note_infos|type)=="array" then .data.note_infos |= map(select((.|type)!="object" or (((((.type? // "") | tostring) | test("^live")) or ((.live|type)=="object" and (.live|length)>0)) | not))) else . end'
http-response-jq ^https?:\/\/search\.xiaohongshu\.com\/api\/search\/fls\/placeholder\? 'if type=="object" and (.data|type)=="object" then setpath(["data","placeholder"]; []) else . end'
http-response-jq ^https?:\/\/so\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/recommend\? 'if type=="object" and (.data|type)=="object" then setpath(["data","items"]; []) else . end'
http-response-jq ^https?:\/\/www\.xiaohongshu\.com\/api\/sns\/v\d+\/tag\/ads_engage$ 'if type=="object" and (.data|type)=="object" then delpaths([["data","default_img_list"]]) else . end'
http-response-jq ^https?:\/\/www\.xiaohongshu\.com\/api\/store\/jpd\/edith\/native\/payment_marketing$ 'if type=="object" and (.data|type)=="object" then setpath(["data"]; {}) else . end'

# ------- 微博去广告&净化 | 微博 -------
http-response-jq ^https:\/\/api\.weibo\.cn\/2\/cardlist\? 'del(.items[] | select(.category == "group"))'
# 微博轻享版banner广告
http-response-jq ^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=trends& 'del(.data.banner)'

# ------- WeiboIntl | 微博轻享版 / 国际版 -------
http-response-jq ^https?:\/\/api\.weibo\.cn\/2\/statuses\/unread_hot_timeline$ 'del(.ad, .advertises, .trends) | if .statuses then .statuses |= map(select(((.promotion.type == "ad") or (.mblogtypename | IN("广告", "廣告", "热推", "熱推"))) | not)) end'
http-response-jq ^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=get_coopen_ads& '.data |= . + {"ad_list":[],"pic_ad":[],"gdt_video_ad_ios":[],"display_ad":0,"ad_ios_id":null,"app_ad_ios_id":null,"reserve_ad_ios_id":"","reserve_app_ad_ios_id":"","ad_duration":604800,"ad_cd_interval":604800}'
http-response-jq ^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=trends& 'if .data.order then .data.order = ["search_topic"] end'
http-response-jq ^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=search_topic& 'if .data.search_topic.cards[0].type == "searchtop" then del(.data.search_topic.cards[0]) end'
http-response-jq ^https?:\/\/weibointl\.api\.weibo\.cn\/portal\.php\?a=user_center& 'if .data.cards then .data.cards[].items |= map(select(.type != "personal_vip")) | .data.cards |= map(select((.items | length) > 0)) end'

# ------- Reddit 去广告 | Reddit -------
# 可调参数: NSFW="Nsfw", TRANSLATION="http-request", TRANSLATION_VALUE="enabled, seo, zh-hans"
# walk(
#   if type == "object" then
#     (if .isNSFW == true then .isNSFW = false else . end)
#     | (if .isNSFWMediaBlocked == true then .isNSFWMediaBlocked = false else . end)
#     | (if .isNSFWContentShown == false then .isNSFWContentShown = true else . end)
#     | (if (.commentsPageAds | type == "array") then (.commentsPageAds = []) else . end)
#     | (if ( (.node | type == "object") and (.node.cells | type == "array") and (.node.cells | any(.__typename? == "AdMetadataCell" or .isAdPost? == true)) ) then empty else . end)
#     | (if (.node | type == "object") and (.node.adPayload | type == "object") then empty else . end)
#     | (if .__typename == "AdPost" then empty else . end)
#   else .
# end)

http-response-jq ^https?:\/\/gql(-fed)?\.reddit\.com 'walk( if type == "object" then (if .is{{{NSFW}}} == true then .is{{{NSFW}}} = false else . end) | (if .is{{{NSFW}}}MediaBlocked == true then .is{{{NSFW}}}MediaBlocked = false else . end) | (if .is{{{NSFW}}}ContentShown == false then .is{{{NSFW}}}ContentShown = true else . end) | (if (.commentsPageAds | type == "array") then (.commentsPageAds = []) else . end) | (if ( (.node | type == "object") and (.node.cells | type == "array") and (.node.cells | any(.__typename? == "AdMetadataCell" or .isAdPost? == true)) ) then empty else . end) | (if (.node | type == "object") and (.node.adPayload | type == "object") then empty else . end) | (if .__typename == "AdPost" then empty else . end) else . end)'

# ------- SDGun 社区去广告 | SDGun 社区 -------
http-response-jq ^https?:\/\/mag1\.sdgun\.net\/mag\/info\/v2\/channel\/infoListByCatId '.list |= map(select(._type != "pic_ad"))'

http-response-jq ^https?:\/\/mag1\.sdgun\.net\/mag\/circle\/v2\/forum\/forumViewV2 '.list |= map(select(.info_list_ad_style_type != 1))'

http-response-jq ^https?:\/\/mag1\.sdgun\.net\/mag\/circle\/v4\/show\/showView 'del(.ads)'

[Script]
# ------- 🅲🅻🅴🅰🅽🅴🆁 | 红果短剧 / 包子漫画网页版 / 小蚁摄像机 / 德施曼 / Pinterest -------
