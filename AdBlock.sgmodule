[Header Rewrite]
# ------- Reddit 去广告 | Reddit -------
# 可调参数: NSFW="Nsfw", TRANSLATION="http-request", TRANSLATION_VALUE="enabled, seo, zh-hans"
{{{TRANSLATION}}} ^https:\/\/gql(-fed)?\.reddit\.com\/ header-del x-reddit-translations
{{{TRANSLATION}}} ^https:\/\/gql(-fed)?\.reddit\.com\/ header-add x-reddit-translations "{{{TRANSLATION_VALUE}}}"

# ------- 🆂🅿🅾🆃🅸🅵🆈 | Spotify -------
# 可调参数: 歌词补全="true", 歌词翻译="true", 翻译语言="zh-CN", 百度翻译="false", 翻译账户="自行申请并填写", 翻译密钥="自行申请并填写"
http-request ^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/(?:user-customization-service\/v1\/customize|nebula\/v1\/configuration\/attributes|remote-config-resolver\/v3\/configuration)\/?(?:\?[^#]*)?$ header-del if-none-match

# ------- GitHub 私库访问 | GitHub 私库（按用户名注入 Token） -------
# 可调参数: 🔘启用用户1=#http, 用户1=填写GitHub用户名, 密钥1=填写你的PAT密钥, 🔘启用用户2=#http, 用户2=填写GitHub用户名, 密钥2=填写你的PAT密钥, 🔘启用用户3=#http, 用户3=填写GitHub用户名, 密钥3=填写你的PAT密钥, 🔘启用用户4=#http, 用户4=填写GitHub用户名, 密钥4=填写你的PAT密钥
{{{🔘启用用户1}}}-request ^https?:\/\/(raw|gist)\.githubusercontent\.com/{{{用户1}}}/ header-replace Authorization "token {{{密钥1}}}"
{{{🔘启用用户2}}}-request ^https?:\/\/(raw|gist)\.githubusercontent\.com/{{{用户2}}}/ header-replace Authorization "token {{{密钥2}}}"
{{{🔘启用用户3}}}-request ^https?:\/\/(raw|gist)\.githubusercontent\.com/{{{用户3}}}/ header-replace Authorization "token {{{密钥3}}}"
{{{🔘启用用户4}}}-request ^https?:\/\/(raw|gist)\.githubusercontent\.com/{{{用户4}}}/ header-replace Authorization "token {{{密钥4}}}"

