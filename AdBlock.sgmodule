#!name=去广告合集 · All-in-One
#!desc=合并 LOWERTOP/Shadowrocket-First 及社区共 26 个去广告模块。生成于 2026-11-18 09:10
#!author=LOWERTOP、向晚、iab0x00、奶思 / fmz200、app2smile、kokoryh、xream / QingRex、iab0x00 / Maasea、Reukix、小白脸 / xream
#!homepage=https://github.com/LOWERTOP/Shadowrocket-First
#!arguments=开屏广告:true,弹窗广告:true,瀑布广告:true,追踪埋点:REJECT,携程网关:DIRECT,屏蔽弹窗:true,屏蔽推广:true,统计策略:REJECT,功能解锁:false,活跃时间:false,允许下载:false,隐身配额:false,更新弹窗:false,地图次数:false,per_filter_video:0,动态最常访问:auto,创作中心:0,过滤置顶评论广告:1,优化评论区加载:bilibili.protobuf.request,空降助手:bilibili.airborne,空降助手策略:DIRECT,屏蔽P2P:DEST-PORT,日志等级:4,NSFW:"Nsfw",TRANSLATION:"http-request",TRANSLATION_VALUE:"enabled, seo, zh-hans",屏蔽上传按钮:true,屏蔽选段按钮:true,屏蔽Shorts按钮:false,启用调试模式:false,字幕翻译语言:off,歌词补全:"true",歌词翻译:"true",翻译语言:"zh-CN",百度翻译:"false",翻译账户:"自行申请并填写",翻译密钥:"自行申请并填写",翻译条目数量:50,翻译目标语言:zh-CN,商店下载加速:iosapps,商店加速地址:iosapps.itunes.apple.com.download.ks-cdn.com,系统升级加速:updates,升级加速地址:updates.cdn-apple.com.download.ks-cdn.com
#!arguments-desc=【🅲🆃🆁🅸🅿🅰🅳】开屏广告：去开屏广告（true=开启，false=关闭）\n弹窗广告：去首页弹窗广告（true=开启，false=关闭）\n瀑布广告：去信息流/Banner 广告（true=开启，false=关闭）\n追踪埋点：广告埋点 ma-adx.ctrip.com（REJECT=拦截，DIRECT=放行）\n携程网关：携程 TCP 网关（REJECT=强制回退 HTTPS，DIRECT=放行；去广告不生效时改为 REJECT）\n【🆃🅴🅻🅳🅰🅿🅿】🔘 屏蔽弹窗: 清空 App 广告位接口 (CMS-GetAppAd) \n🔘 屏蔽推广: 清空商城轮播、PLUS 促销、券包售卖与福利群二维码，默认开启但可能误伤券包购买入口 \n🔘 统计策略: 友盟、Bugly、字节埋点等统计上报，默认 REJECT，填 DIRECT 可放行\n【🆀🅸🅽🅶🅰🅿🅿】🔘 功能解锁: 显示真实视界、提高资料可见度与长视频限制 \n🔘 活跃时间: 显示附近的人的隐身活跃状态 \n🔘 允许下载: 解锁动态图片与视频下载权限 \n🔘 隐身配额: 隐身消息发送配额修改为 999 \n🔘 更新弹窗: 屏蔽版本更新提示弹窗 \n🔘 地图次数: 实验性测试提高每日地图位置切换次数，该功能仅本地实现，可能不可过度突破服务器限制\n【贴吧去广告】per_filter_video:设置为1则推荐页不展示视频贴\n【哔哩哔哩增强】动态最常访问\n- auto: 仅当列表中存在直播状态时显示\n- show: 始终显示\n- hide: 始终隐藏\n\n创作中心\n- 0: 隐藏\n- 1: 显示\n\n过滤置顶评论广告\n- 0: 关闭\n- 1: 开启\n\n优化评论区加载: 默认开启，配置为"#"时关闭\n\n空降助手: 默认开启，配置为"#"时关闭\n\n空降助手策略: 默认直连，建议配置为代理策略\n\n屏蔽P2P: 默认开启，配置为"#"时关闭\n\n日志等级\n- 1: DEBUG\n- 2: INFO\n- 3: WARN\n- 4: ERROR\n- 5: OFF\n【Reddit 去广告】\n1️⃣ NSFW\n\n填写 Nsfw 时, 表示关闭 NSFW 提示, 其他值表示恢复默认行为\n\n2️⃣ TRANSLATION\n\n填写 http-request 时, 表示开启自动翻译, # 表示关闭自动翻译.\n⚠️ 由于无法区分首次原始请求和手动点击翻译的请求, 开启之后 App 内切换功能就无效了...\n\n3️⃣ TRANSLATION_VALUE\n\n如果 Reddit 改了行为, 可以自己改这个值\n【YouTubeNoAds】\n▶ 参数说明:\n\n - 屏蔽按钮: 默认开启，可手动切换\n\n - 调试模式: 默认关闭，非调试无需切换\n\n - 翻译语言: 默认关闭，可自定义语言代码\n\n\n▶ 语言代码：\n\n - 翻译语言可根据需求自定义，语言代码遵循Google Translate Languages Codes，示例如下↓\n\n - 简中: zh-Hans，日语: ja，韩语: ko，西语: es，法语: fr\n【🆂🅿🅾🆃🅸🅵🆈】\n\n模块说明：请停用其他 Spotify 歌词模块，避免重复处理同一接口。若歌词存在官方歌词则优先选用；外部歌词按歌名、歌手和时长匹配；默认使用网易、谷歌等翻译，支持选填百度翻译APPID，启用后若不存在网易人工翻译，则首选百度翻译，可一定程度上避免翻译受限。 \n\n脚本来源：Reukix \n\n歌词补全：启用歌词补全 \n\n歌词翻译：启用歌词翻译 \n\n翻译语言：翻译目标语言，默认 zh-CN \n\n百度翻译：启用百度翻译 \n\n翻译账户：百度翻译开放平台的 APP ID \n\n翻译密钥：百度翻译开放平台的密钥\n【Discord 自动翻译】翻译条目数量：单次响应最多筛选的消息条数，默认 50，最大 1000。\n\n翻译目标语言：填写 Google 翻译支持的语言代码，默认 zh-CN（简体中文）。支持 zh-TW（台湾繁体）、zh-HK（香港繁体）、ja（日语）、ko（韩语）等。\n\n两个参数可以独立修改。\n【苹果助手】🔘 商店下载加速填#可禁用，加速地址可选填其他\n\n· 默认金山CDN，CDN结果为本省\n\n iosapps.itunes.apple.com.download.ks-cdn.com\n\n· 备选网宿CDN，CDN结果为本省或临近省份\n\n hls.itunes.apple.com.mwcname.com\n\n· 备选阿里CDN，CDN结果可能异地\n\n iosapps.itunes.apple.com.m.alikunlun.net\n\n🔘 系统升级加速填#可禁用，加速地址可选填其他\n\n· 默认金山CDN，CDN结果为本省\n\n updates.cdn-apple.com.download.ks-cdn.com\n\n· 备选网宿CDN，CDN结果为本省或临近省份\n\n updates.cdn-apple.com.mwcname.com\n\n· 备选阿里CDN，CDN结果可能异地\n\n updates.cdn-apple.com.w.kunlunca.com

#====================================================================
# 去广告合集（All-in-One）
#
# 整合内容：🅲🅻🅴🅰🅽🅴🆁、🅷🅾🅽🅶🅶🆄🅾、🅲🆃🆁🅸🅿🅰🅳、🆁🆄🅸🆇🅸🅽🅶、🆃🅴🅻🅳🅰🅿🅿、🆀🅸🅽🅶🅰🅿🅿、🅲🅰🅳🆅🅸🅴🆆、高德地图、彩云天气、一汽大众、DiDiClean、小红书、微博去广告&净化、WeiboIntl、贴吧去广告、哔哩哔哩增强、BiliIntlClean、Reddit 去广告、SDGun 社区去广告、YouTubeNoAds、🆂🅿🅾🆃🅸🅵🆈、Discord 自动翻译、GitHub 限制解除、苹果助手、Script Hub、奶思 730 App 拦截合集
# 通用规则集：AntiAD（作者自用）放在最后兜底
#
# 特别提示（哔哩哔哩增强）：
#   需要 Shadowrocket >= 2.2.81(3096)，并在设置里开启 HTTP/2 MITM；
#   低版本请在该模块的 [MITM] 里排除解密 -grpc.biliapi.net，或直接删掉哔哩哔哩段。
#
# 使用前提：
#   1. 全局路由设为「配置」模式，否则模块不生效；
#   2. 开启 HTTPS 解密（安装并信任证书），否则 jq / 脚本类模块无效；
#   3. 各模块自上而下生效，本文件已把具体 App 模块排在通用规则集之前；
#   4. 部分 App 需清除缓存或重装才能看到效果。
#
# 想关掉某个 App：删掉它对应的 `# ------- 名称 -------` 段整块即可。
# 通用规则集（AntiAD）在文件末尾，删除 `# ======= AntiAD` 之后的内容不影响其他模块。
#====================================================================

[General]
force-http-engine-hosts = %APPEND% gql.reddit.com, gql-fed.reddit.com, mag1.sdgun.net, script.hub, *.script.hub

[Rule]
